<idea-plugin>
    <id>fr.pralexio.perplexityintegration</id>
    <name>Perplexity AI Chat</name>
    <vendor email="contact@pralexio.fr" url="https://github.com/Pralexio/PerplexityIntegration">Pralexio</vendor>

    <description><![CDATA[
        <h3>Integrate Perplexity AI directly into your IDE</h3>
        <p>This plugin embeds Perplexity AI into IntelliJ-based IDEs, allowing you to:</p>
        <ul>
            <li>Browse Perplexity AI without leaving your IDE</li>
            <li>Send selected code to Perplexity chat with Ctrl+Shift+P</li>
            <li>Automatic dark mode support</li>
            <li>Session token management for persistent login</li>
            <li>Adjustable zoom controls</li>
            <li>Developer tools access for debugging</li>
            <li>Clear diagnostics when the embedded JetBrains browser is unavailable or incompatible</li>
        </ul>
        <p><strong>Features:</strong></p>
        <ul>
            <li>Native tool window integration</li>
            <li>Context menu action for sending code</li>
            <li>Persistent settings (zoom level, session token)</li>
            <li>Off-screen rendering for Windows compatibility</li>
            <li>Graceful unsupported-runtime message for IDEs without compatible JCEF support</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="fr.pralexio.perplexityintegration.PerplexitySettings"/>
        <applicationService
                serviceImplementation="fr.pralexio.perplexityintegration.PerplexityCredentialStore"/>
        <applicationConfigurable
                parentId="tools"
                instance="fr.pralexio.perplexityintegration.PerplexityConfigurable"
                id="fr.pralexio.perplexityintegration.PerplexityConfigurable"
                displayName="Perplexity AI"/>
        <toolWindow
                id="Perplexity"
                anchor="right"
                icon="/icons/perplexity_action.svg"
                factoryClass="fr.pralexio.perplexityintegration.PerplexityToolWindowFactory"/>
        <notificationGroup
                id="Perplexity.Notifications"
                displayType="BALLOON"/>
    </extensions>

    <actions>
        <group
                id="Perplexity.SendGroup"
                text="Perplexity"
                description="Send selected code to Perplexity"
                icon="/icons/perplexity_action.svg"
                popup="true">
            <action
                    id="SendToPerplexity"
                    class="fr.pralexio.perplexityintegration.SendToPerplexityAction"
                    text="Send Selection"
                    description="Send selected code to Perplexity chat">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift P"/>
            </action>
            <separator/>
            <action
                    id="Perplexity.Explain"
                    class="fr.pralexio.perplexityintegration.PerplexityExplainAction"
                    text="Explain Selection"
                    description="Ask Perplexity to explain the selected code"/>
            <action
                    id="Perplexity.FindBugs"
                    class="fr.pralexio.perplexityintegration.PerplexityFindBugsAction"
                    text="Find Bugs"
                    description="Ask Perplexity to look for bugs and edge cases"/>
            <action
                    id="Perplexity.Optimize"
                    class="fr.pralexio.perplexityintegration.PerplexityOptimizeAction"
                    text="Optimize"
                    description="Ask Perplexity to suggest optimizations"/>
            <action
                    id="Perplexity.WriteTests"
                    class="fr.pralexio.perplexityintegration.PerplexityWriteTestsAction"
                    text="Write Tests"
                    description="Ask Perplexity to generate unit tests"/>
            <action
                    id="Perplexity.Refactor"
                    class="fr.pralexio.perplexityintegration.PerplexityRefactorAction"
                    text="Refactor"
                    description="Ask Perplexity to refactor the selection"/>
            <action
                    id="Perplexity.AddComments"
                    class="fr.pralexio.perplexityintegration.PerplexityAddCommentsAction"
                    text="Add Comments"
                    description="Ask Perplexity to add explanatory comments"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
